{
  "name": "chartjs-database-bar-chart",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc && vite build",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "chart.js": "4.4.4",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "tsx": "^4.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "concurrently": "^8.2.2",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
